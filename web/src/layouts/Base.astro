---
/**
 * Document shell for every page: SEO head, header, footer.
 *
 * All URLs in the head are absolute - canonical, hreflang and Open Graph are
 * ignored or misread as relative paths. They are built from `site`, which the
 * backend rewrites to PUBLIC_URL at serve time (see astro.config.mjs).
 */
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE_NAME, type Lang } from '../i18n/site'

interface Props {
  lang: Lang
  title: string
  description: string
  /** Path of this page in each language, e.g. { de: '/faq', en: '/en/faq' }. */
  alternates: Record<Lang, string>
  noindex?: boolean
  /** schema.org objects, emitted as one JSON-LD block each. */
  jsonLd?: object[]
  /** Absolute or root-relative image for Open Graph; defaults to the site card. */
  ogImage?: string
  ogType?: 'website' | 'article'
  /** The finder renders its own full-screen chrome. */
  bare?: boolean
}

const { lang, title, description, alternates, noindex = false, jsonLd = [], ogType = 'website', bare = false } =
  Astro.props
const site = (Astro.site?.href ?? 'http://localhost:8000/').replace(/\/$/, '')
const abs = (path: string) => (path.startsWith('http') ? path : site + (path === '/' ? '/' : path))
const canonical = abs(alternates[lang])
const ogImage = abs(Astro.props.ogImage ?? `/og/site-${lang}.png`)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang="de" href={abs(alternates.de)} />}
    {!noindex && <link rel="alternate" hreflang="en" href={abs(alternates.en)} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(alternates.de)} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0c1015" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <link rel="manifest" href={lang === 'de' ? '/manifest.webmanifest' : '/en/manifest.webmanifest'} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body class={bare ? 'bare' : undefined}>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <Header lang={lang} alternates={alternates} />
          <main id="main" class="page">
            <slot />
          </main>
          <Footer lang={lang} />
        </>
      )
    }
  </body>
</html>
