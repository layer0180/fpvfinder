---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { ROUTES, type Lang } from '../i18n/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const guides = (await getCollection('guides', (e) => e.data.lang === lang)).sort((a, b) => a.data.order - b.data.order)
const c =
  lang === 'de'
    ? {
        title: 'Ratgeber: FPV fliegen in Deutschland – Regeln und Spots | FPV Flying Spot Finder',
        description: 'Wo du FPV fliegen darfst, was A1, A2 und A3 bedeuten, wie du Geozonen auf dipul prüfst und wie du ruhige Spots findest – kurz, mit Quellen.',
        h1: 'Ratgeber',
        lead: 'Kurze, geprüfte Antworten zu Regeln und Spots – jeweils mit Quellen und dem Datum der letzten Prüfung.',
      }
    : {
        title: 'Guides: flying FPV in Germany – rules and spots | FPV Flying Spot Finder',
        description: 'Where you may fly FPV, what A1, A2 and A3 mean, how to check geographical zones on dipul and how to find quiet spots – short, with sources.',
        h1: 'Guides',
        lead: 'Short, checked answers about rules and spots – each with its sources and the date it was last checked.',
      }
---

<Base lang={lang} title={c.title} description={c.description} alternates={ROUTES.guides}>
  <div class="prose">
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </div>
  <ul class="guide-list">
    {
      guides.map((g) => (
        <li class="card">
          <h2>
            <a href={`${ROUTES.guides[lang]}/${g.data.slug}`}>{g.data.h1}</a>
          </h2>
          <p>{g.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-list h2 {
    margin: 0 0 6px;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .guide-list a {
    text-decoration: none;
  }

  .guide-list a:hover {
    text-decoration: underline;
  }

  .guide-list p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
