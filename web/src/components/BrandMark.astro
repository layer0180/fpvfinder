---
/** Quad seen from above: X frame, four props, a location dot in the middle. */
interface Props {
  class?: string
}
const { class: className = 'brand-mark' } = Astro.props
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round">
    <path d="M9 9 23 23M23 9 9 23" />
    <circle cx="7" cy="7" r="5" />
    <circle cx="25" cy="7" r="5" />
    <circle cx="7" cy="25" r="5" />
    <circle cx="25" cy="25" r="5" />
  </g>
  <circle cx="16" cy="16" r="3.4" fill="var(--text)" />
</svg>
