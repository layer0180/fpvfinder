# Keep the build context small and never ship secrets or local state.

# Secrets
backend/.env
.env

# Local runtime state - the container has its own volumes
backend/data/cache.sqlite
backend/data/cache.sqlite-journal
backend/data/*.tif
backend/data/*.tiff
# weights.json is generated from defaults.py on first start
backend/config/weights.json

# Generated marketing pages - regenerated by `npm run build` inside the image
frontend/index.html
frontend/faq.html
frontend/en/
frontend/public/robots.txt
frontend/public/sitemap.xml

# Build artefacts and environments (rebuilt inside the image)
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
frontend/node_modules/
frontend/dist/

# Repository metadata not needed at build time.
# NOTE: listed explicitly rather than as "*.md" - the legal templates in
# backend/content/ are Markdown and must ship with the image.
.git/
.github/
.gitignore
.gitattributes
docs/
tools/
README.md
LICENSE
start-backend.ps1
start-frontend.ps1
docker-compose.yml
docker-compose.caddy.yml

# Editors / OS
.claude/
.vscode/
.idea/
Thumbs.db
.DS_Store
