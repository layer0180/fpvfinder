# Keep the build context small and never ship secrets or local state.

# Secrets
backend/.env
.env

# Local runtime state - the container has its own volumes
backend/data/cache.sqlite
backend/data/cache.sqlite-journal
backend/data/*.tif
backend/data/*.tiff
# The OSM tile store is mounted or downloaded at runtime, never baked in
*.osm.pbf
backend/data/osm-*.sqlite
backend/data/geocode.sqlite
backend/data/app.sqlite
backend/data/import-work/
backend/data/regions*.json
# weights.json is generated from defaults.py on first start
backend/config/weights.json

# Build artefacts and environments (rebuilt inside the image)
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
web/node_modules/
web/dist/
web/.astro/

# Repository metadata not needed at build time.
# NOTE: listed explicitly rather than as "*.md" - the legal templates in
# backend/content/ are Markdown and must ship with the image.
.git/
.github/
.gitignore
.gitattributes
docs/
tools/
README.md
LICENSE
docker-compose.yml
docker-compose.*.yml

# Editors / OS
.claude/
.vscode/
.idea/
Thumbs.db
.DS_Store
