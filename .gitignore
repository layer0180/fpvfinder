# --- Secrets: NEVER commit these ------------------------------------------
# Contains STRAVA_HEATMAP_COOKIES among other things (personal session signature).
backend/.env
.env
*.env.local

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node -----------------------------------------------------------------
node_modules/
dist/
.vite/
npm-debug.log*

# --- Local runtime data (regenerated automatically) -----------------------
backend/data/cache.sqlite
backend/data/cache.sqlite-journal
# Population raster: several hundred MB, everyone downloads their own
backend/data/*.tif
backend/data/*.tiff

# --- Editors / tooling / OS -----------------------------------------------
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# --- Generated by frontend/scripts/build-site.mjs (content.*.mjs is the source) ---
frontend/index.html
frontend/faq.html
frontend/en/
frontend/public/robots.txt
frontend/public/sitemap.xml
