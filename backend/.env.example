# Copy to backend/.env and adjust.
# Every one of these also works as a plain environment variable, which is how
# you configure the container (docker run -e ..., compose, Coolify).

# --- Public deployment ----------------------------------------------------
# Set this on any instance other people can reach. It disables every endpoint
# that changes server-wide state (weights, no-fly zones, cache) - otherwise one
# visitor could reconfigure the app for everybody else.
PUBLIC_MODE=false

# Enable ONLY when a reverse proxy (Caddy, Traefik, nginx, Coolify's own proxy)
# sits in front and sets X-Forwarded-For. With no proxy in front this lets
# anyone spoof their address and walk straight past the rate limits.
TRUST_PROXY=false

# Your public address, e.g. https://fpvfinder.example.com
#
# Set this before submitting anything to a search engine. The static pages are
# generated with an absolute base URL baked into every canonical link, hreflang,
# Open Graph tag and sitemap entry; PUBLIC_URL replaces it at serve time. Left
# empty, all of those point at http://localhost:8000 and Google rejects the
# sitemap. The startup log prints the address actually being advertised.
PUBLIC_URL=

# Google Search Console ownership proof, HTML-file method.
#
# Search Console -> add property (URL prefix) -> "HTML file" gives you a file
# named google<hash>.html. Put that name here - the app then serves it with the
# content Google expects, so nothing has to be committed or rebuilt. Paste the
# file name, the bare hash or the "google-site-verification: ..." line; all
# three are accepted. Leave empty and the route does not exist at all.
#
# Only needed for a URL-prefix property. If you own the domain and add it as a
# "Domain" property instead, you verify with a DNS TXT record and this stays
# empty.
GOOGLE_SITE_VERIFICATION=

# Self-maintained no-fly zones from backend/data/airspace.geojson. Off by
# default - the shipped file holds clearly-marked EXAMPLE geometry, and showing
# invented control zones on a map is worse than showing none. Switch this on
# only once that file contains real zones you maintain yourself.
AIRSPACE_ENABLED=false

# --- Request limits -------------------------------------------------------
# Memory use grows with the SQUARE of the radius. Measured on this codebase
# (Python heap; resident set is higher):
#     2.5 km -> ~40 MiB      5 km -> ~240 MiB      10 km -> ~1 GiB
# Choose this to fit your container and leave headroom. A 512 MB instance
# should not go above ~5 km.
MAX_RADIUS_KM=20
MIN_SPACING_M=50
MAX_RESULTS=2000

# How many searches run at once, and how many may queue behind them.
# Each running search holds a full OSM extract in memory, so on a small
# container keep this at 1.
SEARCH_MAX_CONCURRENT=2
SEARCH_MAX_QUEUED=8

# --- Rate limits (burst count / refill window in seconds, per client) ------
RATE_SEARCH_BURST=5
RATE_SEARCH_PER_S=300
RATE_GEOCODE_BURST=20
RATE_GEOCODE_PER_S=120

# --- Donations and legal pages --------------------------------------------
# Leave DONATE_URL empty and no button is rendered at all.
DONATE_URL=
DONATE_LABEL=Buy me a coffee

# The imprint and privacy pages use this as the contact route, so no personal
# details have to be published. Defaults to the project repository.
PROJECT_URL=https://github.com/Layer0180/fpvfinder
# Optional. Only used if a template asks for {{CONTACT_EMAIL}}; falls back to
# PROJECT_URL when empty.
CONTACT_EMAIL=
# The imprint and privacy texts live in backend/content/*.md - edit those
# files (or mount your own) rather than changing any code.

# --- Overpass -------------------------------------------------------------
# Comma separated list of instances. If one fails (HTTP 429/504), the next
# attempt automatically uses the following one. Order = priority.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_S=240
# Minimum gap between two Overpass requests, in seconds (please keep >= 1.0)
OVERPASS_MIN_INTERVAL_S=1.5
OVERPASS_MAX_RETRIES=4
# Cache tile size in degrees (0.1 is roughly 11 km).
# Reduce to 0.05 if you see frequent HTTP 504s: more requests, but lighter ones.
OVERPASS_TILE_DEG=0.1
OVERPASS_CACHE_TTL_DAYS=30

# --- Nominatim ------------------------------------------------------------
# Identifies this app to Nominatim and Overpass. The OSM usage policy requires
# something that identifies the application and offers a contact route.
#
# IMPORTANT: Nominatim answers 403 to any User-Agent containing "example.com",
# because that means the placeholder was never replaced. Shipped as-is it still
# works - the backend falls back to the project URL and warns at startup - but
# put your own address here if you run this publicly.
USER_AGENT=fpvfinder/0.1 (+https://github.com/Layer0180/fpvfinder)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Strava heatmap -------------------------------------------------------
# IMPORTANT: normally there is nothing to do here.
# Strava serves the heatmap up to and including zoom 12 without any login
# (~25 m/pixel at 48 degrees north, which is plenty for a 150 m grid), so the
# layer works out of the box.
#
# You only need cookies if you want to sample finer than zoom 12:
#   1. Log in to strava.com in Chrome or Firefox
#   2. Open https://www.strava.com/heatmap and zoom in past zoom 12
#   3. DevTools (F12) -> Network -> click one of the .png tile requests
#   4. Copy the complete "Cookie" request header and paste it below
#   5. Put the host and path you saw into STRAVA_TILE_URL
#
# CAUTION: Strava moves this endpoint around regularly, and the cookies are
# bound to exactly one CloudFront distribution. If the two do not match, the
# server answers 403 "InvalidKey". The backend detects this with a single test
# fetch and falls back to zoom 12 automatically - a search always completes.
#
# Never put a real cookie in this file: it is committed to the repository and
# the browser cookie header also contains your active Strava login token.
STRAVA_HEATMAP_COOKIES=
# STRAVA_TILE_URL=https://heatmap-external-a.strava.com/tiles-auth/{activity}/{color}/{z}/{x}/{y}.png?px=256
# STRAVA_TILE_URL_PUBLIC=https://heatmap-external-a.strava.com/tiles/{activity}/{color}/{z}/{x}/{y}.png?px=256
# STRAVA_PUBLIC_MAX_ZOOM=12

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
