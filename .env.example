# Copy to .env next to docker-compose.yml and fill in. Every line is optional;
# anything left out uses the default from docker-compose.yml.
# v1 .env files keep working - the new settings are additions.

# --- Your public instance ------------------------------------------------------
# With the Caddy overlay (docker-compose.caddy.yml) these two are all you need:
DOMAIN=fpv-finder.example
ACME_EMAIL=you@example.org
# Without Caddy, set these yourself (the overlay sets them for you):
# PUBLIC_URL=https://fpv-finder.example
# PUBLIC_MODE=true
# TRUST_PROXY=true          # only behind a reverse proxy

# Search Console, HTML-file method (file name, bare hash or the full line).
GOOGLE_SITE_VERIFICATION=

# --- OSM data for Germany ------------------------------------------------------
# The prebuilt tile store, refreshed monthly by .github/workflows/osm-data.yml.
# Downloaded on first start (~1.5 GB), then again when older than the max age.
OSM_STORE_URL=https://github.com/Layer0180/fpvfinder/releases/download/osm-data/osm-germany.sqlite
OSM_STORE_MAX_AGE_DAYS=35
# Data for the region pages (/regionen/<city>), published with the store.
REGIONS_URL=https://github.com/Layer0180/fpvfinder/releases/download/osm-data/regions.json
# Outside Germany: false = "not covered" (recommended for a small public
# server), true = ask the public Overpass servers live.
# OSM_LIVE_FALLBACK=false

# --- Sizing for a 2 GB / 1 CPU server -------------------------------------------
MAX_RADIUS_KM=10
SEARCH_MAX_CONCURRENT=1
SEARCH_MAX_QUEUED=6

# --- Donations and contact -----------------------------------------------------
# Empty = no donation button. Change it - otherwise you send your visitors to
# somebody else's page.
DONATE_URL=
DONATE_LABEL=Buy me a coffee
PROJECT_URL=https://github.com/Layer0180/fpvfinder

# --- Imprint (§ 5 DDG) -----------------------------------------------------------
# Shown on /impressum and /en/imprint. Kept here, not in the repository, so
# your name and address stay out of git. Address lines comma separated.
OPERATOR_NAME=
OPERATOR_ADDRESS=
CONTACT_EMAIL=

# --- Visitor statistics (optional, `--profile analytics`) -----------------------
# Umami: cookieless, no personal data. Generate the two secrets once, e.g.
#   openssl rand -hex 24
# UMAMI_DB_PASSWORD=
# UMAMI_APP_SECRET=
# ANALYTICS_DOMAIN=stats.fpv-finder.example
# After adding the site in Umami (log in, change the default password!):
# ANALYTICS_SCRIPT_URL=https://stats.fpv-finder.example/script.js
# ANALYTICS_WEBSITE_ID=

# --- Rarely needed -------------------------------------------------------------
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# PHOTON_URL=https://photon.komoot.io
# GEOCODE_COUNTRY=de
# STRAVA_ENABLED=           # empty: off when PUBLIC_MODE, on otherwise
# USER_AGENT=fpvfinder/2.0 (+https://fpv-finder.example)
