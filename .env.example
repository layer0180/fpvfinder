# Configuration for docker-compose.yml.
#
# Copy this to .env in the same directory (docker compose loads it
# automatically - no --env-file flag needed) and fill in your own values:
#
#     cp .env.example .env
#
# .env is gitignored, so your values survive a `git pull` instead of being
# overwritten by the next update to docker-compose.yml. Everything below has a
# sensible fallback in docker-compose.yml itself, so an empty .env - or no
# .env at all - still runs; you are only filling in what you want to change.
#
# This is the Docker-Compose counterpart to backend/.env.example, which is for
# running the backend directly with uvicorn instead of in a container.

# Your public address, e.g. https://fpvfinder.example.com
#
# Set this before submitting anything to a search engine. The static pages
# carry an absolute base URL in every canonical link, hreflang, og:url and
# sitemap entry; PUBLIC_URL replaces it at serve time. Left empty, all of
# those point at http://localhost:8000 and Google rejects the sitemap. The
# startup log prints the address actually being advertised.
PUBLIC_URL=

# Google Search Console ownership proof, HTML-file method. Only needed for a
# URL-prefix property; a Domain property is verified over DNS instead and
# leaves this empty. See docs/search-console.md.
GOOGLE_SITE_VERIFICATION=

# How this app identifies itself to Nominatim and Overpass. Both want a way to
# reach the operator; never "example.com", which Nominatim answers with a flat
# 403.
USER_AGENT=fpvfinder/0.1 (+https://github.com/Layer0180/fpvfinder)

# Change or remove this - otherwise you are pointing your visitors at
# somebody else's donation page. Empty means the button is not rendered.
DONATE_URL=
DONATE_LABEL=Buy me a coffee

# Memory grows with the square of the radius (~240 MiB heap at 5 km, ~1 GiB at
# 10 km). Keep this in step with the memory limit in docker-compose.yml.
MAX_RADIUS_KM=10
SEARCH_MAX_CONCURRENT=2
SEARCH_MAX_QUEUED=8

# Enable for any instance other people can reach, and only set TRUST_PROXY
# when something in front of this container actually terminates TLS and sets
# X-Forwarded-For - enabling it without a proxy lets anyone spoof their
# address and walk straight past the rate limits.
PUBLIC_MODE=false
TRUST_PROXY=false

# Only for the Caddy TLS overlay (docker-compose.caddy.yml). Ignored otherwise.
# DOMAIN=fpv-finder.com
# ACME_EMAIL=you@example.com
